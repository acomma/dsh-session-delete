{
  "name": "@local/dsh-session-delete",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Delete a stored DSH session permanently from the session row menu, and optionally delete every session of a workspace from the Workspace delete dialog, reclaiming attachments only the removed sessions referenced",
  "scripts": {
    "test": "node test/all.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  }
}
