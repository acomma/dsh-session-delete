{
  "name": "@acomma/dsh-session-delete",
  "version": "1.0.0",
  "type": "module",
  "description": "Delete a stored DSH session permanently from the session row menu, reclaiming attachments only that session referenced (on by default)",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "acomma (https://github.com/acomma)",
  "homepage": "https://github.com/acomma/dsh-session-delete#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acomma/dsh-session-delete.git"
  },
  "bugs": {
    "url": "https://github.com/acomma/dsh-session-delete/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session",
    "delete"
  ],
  "main": "index.js",
  "scripts": {
    "test": "node --test test/session-delete.test.mjs test/client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
