{
  "name": "@local/dsh-session-delete",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Delete a stored DSH session permanently from the session row menu, reclaiming attachments only that session referenced (on by default)",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/session-delete.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
